# Modelo de /etc/cinzas/cinzas.env (lido por cinzas.service e cinzas-contas.service).
#   sudo install -d -m 0750 /etc/cinzas
#   sudo install -m 0600 deploy/cinzas.env.exemplo /etc/cinzas/cinzas.env   # depois edite
# Nunca versione o arquivo preenchido.

# Login só com token do serviço de contas (cadastro e senha direto no servidor de zona ficam desligados)
CINZAS_AUTH=token
# Segredo compartilhado pela zona e pelo serviço de contas: openssl rand -hex 32
# (os dois serviços recusam subir com este valor de exemplo ou com menos de 32 caracteres)
CINZAS_TOKEN_SECRET=troque-por-um-segredo-longo
# O Caddy da máquina repassa o IP real em X-Forwarded-For
CINZAS_TRUST_PROXY=1
CINZAS_MAX_CONN_PER_IP=8
CINZAS_LOG_FORMAT=json
# Versão desta implantação, como aparece no hello, no registro de início e em cada /bug: a tag da release sem
# o "v", com o sufixo (D150). A imagem Docker da release já traz a dela; sem a variável vale a do package.json.
#CINZAS_VERSION=0.4.0-teste.2

# Teto de personagens no mundo ao mesmo tempo (0 = sem limite); contas gm e admin entram sempre
CINZAS_MAX_PLAYERS=200

# PostgreSQL central (docs/08-operacao.md §8.11): tire o "--db ..." do ExecStart de cinzas.service e de
# cinzas-contas.service e descomente (este arquivo é só do root; a senha pode ir na URL).
#CINZAS_DB=postgres://cinzas:troque-esta-senha@db.interno:5432/cinzas

# E-mail do serviço de contas (códigos de confirmação e de troca de senha). O remetente precisa ser de um
# domínio verificado no provedor (SPF, DKIM e DMARC: docs/08-operacao.md §8.8). Porta 465 = TLS direto;
# 587 = STARTTLS obrigatório (sem ele o envio falha em vez de mandar a senha do SMTP às claras).
CINZAS_EMAIL=smtp
CINZAS_SMTP_HOST=smtp.exemplo.com.br
CINZAS_SMTP_PORT=587
#CINZAS_SMTP_TLS=starttls
CINZAS_SMTP_USER=usuario
CINZAS_SMTP_PASS=senha
CINZAS_SMTP_FROM=Cinzas do Meridiano <nao-responda@exemplo.com.br>
# Só para um servidor de e-mail próprio com certificado de uma CA privada: as autoridades do arquivo PEM se somam
# às públicas (a conferência do certificado nunca é desligada). Gmail e provedores comerciais não precisam. O
# arquivo é lido pelo usuário cinzas: fora de /etc/cinzas (que é só do root), ex. /opt/cinzas/ca-smtp.pem.
#CINZAS_SMTP_CA=/opt/cinzas/ca-smtp.pem
